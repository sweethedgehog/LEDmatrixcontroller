        app:layout_constraintStart_toStartOf="@+id/perlin_mic_timeput_text_view"
        app:layout_constraintTop_toBottomOf="@+id/perlin_mic_timeput_text_view" />

    <EditText
        android:id="@+id/perlin_mic_pulse_plain_text"
