        app:layout_constraintTop_toTopOf="@+id/perlin_allow_mic_switch"
        app:layout_constraintVertical_bias="0.483" />

    <EditText
        android:id="@+id/perlin_speed_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:layout_marginStart="48dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_speed_text_view"
        app:layout_constraintStart_toEndOf="@+id/perlin_speed_text_view"
        app:layout_constraintTop_toTopOf="@+id/perlin_speed_text_view" />

    <EditText
        android:id="@+id/perlin_run_jump_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/perlin_brightness_plain_text"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/perlin_brightness_plain_text"
        app:layout_constraintTop_toBottomOf="@+id/perlin_brightness_plain_text" />

    <EditText
        android:id="@+id/perlin_brightness_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_brightness_text_view"
        app:layout_constraintEnd_toEndOf="@+id/perlin_mic_pulse_plain_text"
        app:layout_constraintStart_toStartOf="@+id/perlin_mic_pulse_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_brightness_text_view" />

    <EditText
        android:id="@+id/perlin_max_sat_flash_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_max_sat_flash_text_view"
        app:layout_constraintEnd_toEndOf="@+id/perlin_speed_plain_text"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/perlin_speed_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_max_sat_flash_text_view" />

    <EditText
        android:id="@+id/perlin_sat_flash_reduce_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_sat_flash_reduce_text_view"
        app:layout_constraintEnd_toEndOf="@+id/perlin_speed_plain_text"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/perlin_speed_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_sat_flash_reduce_text_view" />

    <EditText
        android:id="@+id/perlin_grid_width_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:layout_marginStart="12dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_grid_width_text_view"
        app:layout_constraintStart_toEndOf="@+id/perlin_grid_width_text_view"
        app:layout_constraintTop_toTopOf="@+id/perlin_grid_width_text_view" />

    <EditText
        android:id="@+id/perlin_z_scale_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_z_scale_text_view"
        app:layout_constraintStart_toStartOf="@+id/perlin_grid_width_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_z_scale_text_view" />

    <EditText
        android:id="@+id/perlin_hue_offset_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_hue_offset_text_view"
        app:layout_constraintStart_toStartOf="@+id/perlin_grid_width_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_hue_offset_text_view" />

    <EditText
        android:id="@+id/perlin_grid_height_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:layout_marginStart="12dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_grid_height_text_view"
        app:layout_constraintStart_toEndOf="@+id/perlin_grid_height_text_view"
        app:layout_constraintTop_toTopOf="@+id/perlin_grid_height_text_view" />

    <EditText
        android:id="@+id/perlin_hue_scale_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_hue_scale_text_view"
        app:layout_constraintStart_toStartOf="@+id/perlin_grid_height_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_hue_scale_text_view" />

    <EditText
        android:id="@+id/perlin_saturation_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_saturation_text_view"
        app:layout_constraintStart_toStartOf="@+id/perlin_grid_height_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_saturation_text_view" />

    <EditText
        android:id="@+id/perlin_max_br_flash_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_max_br_flash_text_view"
        app:layout_constraintEnd_toEndOf="@+id/perlin_run_jump_plain_text"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/perlin_run_jump_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_max_br_flash_text_view" />

    <EditText
        android:id="@+id/perlin_br_flash_reduce_plain_text"
        android:layout_width="65dp"
        android:layout_height="49dp"
        android:ems="10"
        android:imeOptions="flagNoEnterAction"
        android:inputType="number"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_br_flash_reduce_text_view"
        app:layout_constraintEnd_toEndOf="@+id/perlin_run_jump_plain_text"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/perlin_run_jump_plain_text"
        app:layout_constraintTop_toTopOf="@+id/perlin_br_flash_reduce_text_view" />

    <ImageButton
        android:id="@+id/perlin_back_to_menu_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/perlin_profile_select_button"
        app:layout_constraintTop_toTopOf="@+id/perlin_profile_select_button"
        app:srcCompat="@android:drawable/ic_menu_revert" />

    <ImageButton
        android:id="@+id/perlin_profile_select_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="108dp"
        app:layout_constraintStart_toEndOf="@+id/perlin_idle_text_view"
        app:layout_constraintTop_toTopOf="@+id/perlin_idle_text_view"
        app:srcCompat="@android:drawable/ic_menu_sort_by_size" />

    <ImageButton
        android:id="@+id/perlin_delete_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        app:layout_constraintStart_toEndOf="@+id/perlin_idle_text_view"
        app:layout_constraintTop_toTopOf="@+id/perlin_idle_text_view"
        app:srcCompat="@android:drawable/ic_menu_delete" />

    <Switch
        android:id="@+id/perlin_allow_mic_switch"
        android:layout_width="138dp"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:text="Разрешить микрофон"
        app:layout_constraintStart_toStartOf="@+id/perlin_speed_text_view"
        app:layout_constraintTop_toBottomOf="@+id/perlin_speed_text_view" />
