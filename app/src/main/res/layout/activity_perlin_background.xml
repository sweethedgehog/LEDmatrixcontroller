    <TextView
        android:id="@+id/perlin_hue_scale_text_view"
        android:layout_width="81dp"
        android:layout_height="36dp"
        android:text="Множитель оттенка"
        app:layout_constraintBottom_toBottomOf="@+id/perlin_z_scale_text_view"
        app:layout_constraintStart_toStartOf="@+id/perlin_grid_height_text_view"
        app:layout_constraintTop_toTopOf="@+id/perlin_z_scale_text_view"
