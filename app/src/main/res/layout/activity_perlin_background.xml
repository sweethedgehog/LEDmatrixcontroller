    <TextView
        android:id="@+id/perlin_hue_offset_text_view"
        android:layout_width="81dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:text="Смещение оттенка"
        app:layout_constraintStart_toStartOf="@+id/perlin_z_scale_text_view"
