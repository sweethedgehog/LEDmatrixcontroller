        android:layout_width="114dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:text="Шаг убывания насыщенность"
        app:layout_constraintStart_toStartOf="@+id/perlin_allow_mic_switch"
        app:layout_constraintTop_toBottomOf="@+id/perlin_max_sat_flash_text_view" />

    <TextView
        android:id="@+id/perlin_grid_width_text_view"
        android:layout_width="97dp"
        android:layout_height="37dp"
        android:layout_marginTop="48dp"
        android:text="Ширина сетки векторов"
        app:layout_constraintStart_toStartOf="@+id/perlin_sat_flash_reduce_text_view"
